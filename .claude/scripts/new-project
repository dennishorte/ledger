#!/usr/bin/env bash
# Create a new ledger-managed project.
# Usage: new-project <project-path> [--name NAME]
#
# Idempotent: existing files/dirs are left untouched (skipped with a notice).
set -euo pipefail

LEDGER_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

usage() {
  echo "usage: new-project <project-path> [--name NAME]" >&2
  exit 2
}

# ── argument parsing ──────────────────────────────────────────────────────────
PROJECT_PATH=""
PROJECT_NAME=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --name)     PROJECT_NAME="$2"; shift 2 ;;
    --app-port|--api-port) echo "new-project: $1 is ignored; ledger does not run a server" >&2; shift 2 ;;
    -h|--help)  usage ;;
    -*)         echo "new-project: unknown option: $1" >&2; usage ;;
    *)
      if [[ -n "$PROJECT_PATH" ]]; then
        echo "new-project: unexpected argument: $1" >&2; usage
      fi
      PROJECT_PATH="$1"
      shift
      ;;
  esac
done

[[ -z "$PROJECT_PATH" ]] && usage

# ── resolve / validate ────────────────────────────────────────────────────────
# Resolve to absolute path without requiring the directory to exist yet
if [[ "$PROJECT_PATH" != /* ]]; then
  PROJECT_PATH="$(pwd)/$PROJECT_PATH"
fi

[[ -z "$PROJECT_NAME" ]] && PROJECT_NAME="$(basename "$PROJECT_PATH")"

TODAY="$(date +%Y-%m-%d)"

# ── helpers ───────────────────────────────────────────────────────────────────
write_file() {
  local dest="$1"
  local content="$2"
  if [[ -e "$dest" ]]; then
    echo "  skip  $dest  (already exists)"
  else
    printf '%s\n' "$content" > "$dest"
    echo "  write $dest"
  fi
}

copy_file() {
  local src="$1"
  local dest="$2"
  if [[ -e "$dest" ]]; then
    echo "  skip  $dest  (already exists)"
  else
    cp "$src" "$dest"
    echo "  copy  $dest"
  fi
}

# ── directories (mkdir -p is idempotent) ──────────────────────────────────────
echo "Setting up: $PROJECT_PATH"
mkdir -p "$PROJECT_PATH/.ledger/process"

# ── docs/00-project.md ───────────────────────────────────────────────────────
write_file "$PROJECT_PATH/docs/00-project.md" \
"# $PROJECT_NAME

**Last updated:** $TODAY

## What this is for

*(the problem this project exists to solve)*

## What this project contains

*(what the project is, and what is in scope)*

## Decisions

| Decision | Why |
|---|---|

## Open issues

An issue that belongs to one plan stays on that plan. This section is for a problem that crosses plans.

*(none yet)*

## Plans

Work documents live in \`docs/_plans/\`. This list is the ones that exist.

| ID | Title | Depends on | Status |
|----|-------|------------|--------|"

# ── .ledger/process/ (framework playbooks) ───────────────────────────────────
for src in "$LEDGER_DIR/.ledger/process/"*.md; do
  copy_file "$src" "$PROJECT_PATH/.ledger/process/$(basename "$src")"
done

# ── CLAUDE.md ─────────────────────────────────────────────────────────────────
if [[ -e "$PROJECT_PATH/CLAUDE.md" ]]; then
  echo "  skip  $PROJECT_PATH/CLAUDE.md  (already exists)"
else
  # Written with a single-quoted heredoc (no shell expansion) then substituted
  # so backtick/dollar content in the markdown is not interpreted by bash.
  cat > "$PROJECT_PATH/CLAUDE.md" << 'CLAUDE_MD_EOF'
# Claude/agent briefing — {{PROJECT_NAME}}

This project uses the **ledger framework** — a document-driven, spec-verified workflow for LLM-assisted engineering. Every implementation node is governed by a doc in `docs/` that tracks status, decisions, and verification through its lifecycle.

## Start here

- **`docs/00-project.md`** — project root. Read first for purpose, standing decisions, and the list of plans.
- **`.ledger/process/plan-workflow.md`** — how a plan goes from a confirmed outcome through acceptance. Read it before driving a plan.

**To find current focus:** start at the Plans list in `docs/00-project.md` and descend through Status fields. The most-recently-advanced plan tells you where work currently lives.

## How work proceeds

Follow `.ledger/process/plan-workflow.md`. There is no ledger server and no ledger UI.

## Documentation discipline

A node is one piece of work under `docs/_plans/`. The lasting description follows the shape of the project: each part has a living doc in that part's folder. A point-in-time writeup stays in `docs/_investigations/`.

Every plan follows `.ledger/process/plan-workflow.md`. The sections, the status values, and the steps are in that file.

## File naming and placement

A plan is `docs/_plans/NN-name.md`. A plan that has sub-plans stays at that path. Its pieces go in `docs/_plans/NN-name/`, as `MM-piece.md`. `NN` and `MM` are zero-padded two-digit numbers. Leave a gap when inserting; do not renumber.

## Hard constraints

- **No implementation until the implementation design has passed review.**
- **Harness `isolation: 'worktree'` is read-only-only.** The Agent-tool worktree forks from the pushed remote (`origin/<baseBranch>`), NOT your local HEAD — so during a session with unpushed commits it works against a stale tree, and its branch must never be merged back. Reserve it for read-only fan-out. Route all file-mutating work through the `plan-workflow` playbook (it branches from local `<baseBranch>` and merges cleanly) or run it in-place. The integration branch is `main`.
- Each gate is its own commit on the plan. A parent plan does not keep a copy of a sub-plan's status.
- The doc tree is the source of truth. If code and a doc disagree, either the doc wins or it must be updated to reflect a deliberate change — never silently.
- Decisions made in conversation that aren't in the docs are not durable — persist them.

## Process notes

- **Framework playbooks** live in `.ledger/process/`.
- Status is tracked in the plan's own doc.
CLAUDE_MD_EOF
  sed -i '' \
    -e "s/{{PROJECT_NAME}}/$PROJECT_NAME/g" \
    "$PROJECT_PATH/CLAUDE.md"
  echo "  write $PROJECT_PATH/CLAUDE.md"
fi

# ── .gitignore ───────────────────────────────────────────────────────────────
write_file "$PROJECT_PATH/.gitignore" \
'.DS_Store'

# ── register in child-projects ───────────────────────────────────────────────
REGISTRY="$LEDGER_DIR/.ledger/child-projects"
if grep -qxF "$PROJECT_PATH" "$REGISTRY" 2>/dev/null; then
  echo "  skip  registry  (already listed)"
else
  echo "$PROJECT_PATH" >> "$REGISTRY"
  echo "  register $PROJECT_PATH"
fi

# ── summary ───────────────────────────────────────────────────────────────────
echo ""
echo "Done. Playbooks are in $PROJECT_PATH/.ledger/process/"
