#!/usr/bin/env bash
# Block until the API (LEDGER_PORT, default 4180) answers 200 on /api/_health.
# Exits 0 when it is up; non-zero on timeout.
#
# Usage: wait-ready [timeout-seconds]   (default 30)
set -euo pipefail

timeout="${1:-30}"
port="${LEDGER_PORT:-4180}"
deadline=$(( $(date +%s) + timeout ))

while (( $(date +%s) < deadline )); do
  if curl -sf -o /dev/null --max-time 1 "http://localhost:${port}/api/_health"; then
    echo "ready  api=:${port}"
    exit 0
  fi
  sleep 0.5
done

echo "wait-ready: timeout after ${timeout}s  api=:${port}" >&2
exit 1
