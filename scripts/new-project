#!/usr/bin/env bash
# Create a new ledger-managed project.
# Usage: new-project <project-path> [--name NAME]
#
# Idempotent: existing files/dirs are left untouched (skipped with a notice).
set -euo pipefail

LEDGER_DIR="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "usage: new-project <project-path> [--name NAME]" >&2
  exit 2
}

# ── argument parsing ──────────────────────────────────────────────────────────
PROJECT_PATH=""
PROJECT_NAME=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --name)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "new-project: --name requires a value" >&2
        usage
      fi
      PROJECT_NAME="$2"; shift 2 ;;
    -h|--help)  usage ;;
    -*)         echo "new-project: unknown option: $1" >&2; usage ;;
    *)
      if [[ -n "$PROJECT_PATH" ]]; then
        echo "new-project: unexpected argument: $1" >&2; usage
      fi
      PROJECT_PATH="$1"
      shift
      ;;
  esac
done

[[ -z "$PROJECT_PATH" ]] && usage

# ── resolve / validate ────────────────────────────────────────────────────────
# Resolve to absolute path without requiring the directory to exist yet
if [[ "$PROJECT_PATH" != /* ]]; then
  PROJECT_PATH="$(pwd)/$PROJECT_PATH"
fi

[[ -z "$PROJECT_NAME" ]] && PROJECT_NAME="$(basename "$PROJECT_PATH")"

# ── helpers ───────────────────────────────────────────────────────────────────
write_file() {
  local dest="$1"
  local content="$2"
  if [[ -e "$dest" ]]; then
    echo "  skip  $dest  (already exists)"
  else
    printf '%s\n' "$content" > "$dest"
    echo "  write $dest"
  fi
}

copy_file() {
  local src="$1"
  local dest="$2"
  if [[ -e "$dest" ]]; then
    echo "  skip  $dest  (already exists)"
  else
    cp "$src" "$dest"
    echo "  copy  $dest"
  fi
}

# ── directories (mkdir -p is idempotent) ──────────────────────────────────────
echo "Setting up: $PROJECT_PATH"
mkdir -p "$PROJECT_PATH/docs" "$PROJECT_PATH/.ledger/process"

# ── docs/00-project.md ───────────────────────────────────────────────────────
write_file "$PROJECT_PATH/docs/00-project.md" \
"# $PROJECT_NAME

## Responsibility

None

## Parts

None

## Offers

None

## Dependencies

None

## Behavior

None

## Rules

None

## Words

None

## Checked

None"

# ── .ledger/process/ (framework playbooks) ───────────────────────────────────
for src in "$LEDGER_DIR/.ledger/process/"*.md; do
  copy_file "$src" "$PROJECT_PATH/.ledger/process/$(basename "$src")"
done

# ── CLAUDE.md ─────────────────────────────────────────────────────────────────
if [[ -e "$PROJECT_PATH/CLAUDE.md" ]]; then
  echo "  skip  $PROJECT_PATH/CLAUDE.md  (already exists)"
else
  # Written with a single-quoted heredoc (no shell expansion) then substituted
  # so backtick/dollar content in the markdown is not interpreted by bash.
  cat > "$PROJECT_PATH/CLAUDE.md" << 'CLAUDE_MD_EOF'
# Claude/agent briefing — {{PROJECT_NAME}}

Work is specified in `docs/`, reviewed by someone who did not write it, and promoted only when the operator says so.

## Start here

- **`docs/00-project.md`** — the root page of the system record. Read it for what this system does and the obligations it keeps.
- **`.ledger/process/system-record.md`** — how a page is written, read, and edited. Read it before changing a page.
- **`.ledger/process/plan-workflow.md`** — how a plan goes from a confirmed outcome through acceptance. Read it before driving a plan.
- **`.ledger/process/verification-signoff.md`** — the review matrix, and the only definition of `pass`.

## Documentation discipline

A node is one piece of work under `docs/_plans/`. The lasting description is the system record: one page per part under `docs/`, outside `_plans/` and `_investigations/`. How a page is written, read, and edited is `.ledger/process/system-record.md`. A point-in-time writeup stays in `docs/_investigations/`.

Every plan follows `plan-workflow.md`.

- **Status:** `outcome`, `coordinating`, `requirements`, `test-design`, `tests`, `design`, `implementation`, `accepted`.
- **Sections:** Part, Outcome, Decisions, Requirements, Test design, Tests, Design, Implementation notes, Reviews.
- No implementation until the implementation design has passed review.

**To find current focus:** read the plans in `docs/_plans/`. The most-recently-advanced plan tells you where work currently lives.

## How work proceeds

Follow `plan-workflow.md`. Each gate is its own commit on the plan. An independent reviewer writes the sign-off matrix. The person running the project accepts the finished work.

## Hard constraints

- **No implementation until the implementation design has passed review.**
- **Harness `isolation: 'worktree'` is read-only-only.** That worktree forks from the pushed remote, so during a session with unpushed commits it is stale, and its branch must never be merged back. Use it for read-only work. File-changing work follows `plan-workflow.md`, which branches from the local integration branch (`main`).
- Each gate is its own commit on the plan. A parent plan does not keep a copy of a sub-plan's status.
- The doc tree is the source of truth. If a doc and the work disagree, update one of them on purpose. A fact that stays only in conversation is not durable; write it on the page that homes it.
CLAUDE_MD_EOF
  sed -i '' \
    -e "s/{{PROJECT_NAME}}/$PROJECT_NAME/g" \
    "$PROJECT_PATH/CLAUDE.md"
  echo "  write $PROJECT_PATH/CLAUDE.md"
fi

# ── .gitignore ───────────────────────────────────────────────────────────────
write_file "$PROJECT_PATH/.gitignore" \
'.DS_Store'

# ── register in child-projects ───────────────────────────────────────────────
REGISTRY="$LEDGER_DIR/.ledger/child-projects"
if grep -qxF "$PROJECT_PATH" "$REGISTRY" 2>/dev/null; then
  echo "  skip  registry  (already listed)"
else
  echo "$PROJECT_PATH" >> "$REGISTRY"
  echo "  register $PROJECT_PATH"
fi

# ── summary ───────────────────────────────────────────────────────────────────
echo ""
echo "Done. Playbooks are in $PROJECT_PATH/.ledger/process/"
