{
  "schemaVersion": 1,
  "name": "Ledger",
  "docs": "docs",
  "agent": "claude-code",
  "workflow": {
    "baseBranch": "main",
    "rootDoc": "00-project",
    "typesEntrypoint": "packages/parser/src/index.ts",
    "apiPort": 4180,
    "worktreeSetup": [
      { "label": "link-env", "command": "ln -sf {repo}/.env {dir}/.env" }
    ],
    "gates": [
      { "label": "parser-build", "command": "pnpm -C {dir}/packages/parser build" },
      { "label": "server-typecheck", "command": "pnpm -C {dir}/server typecheck" },
      { "label": "server-lint", "command": "pnpm -C {dir}/server lint" },
      { "label": "server-test", "command": "pnpm -C {dir}/server test" }
    ]
  }
}
